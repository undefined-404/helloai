# ============================================================
# HelloAI .gitignore
# ============================================================

# --- Java / Maven ---
*.class
*.jar
*.war
*.ear
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
dependency-reduced-pom.xml
build/

# --- Vue / Node ---
node_modules/
dist/
*.tsbuildinfo

# --- IDE ---
.idea/
*.iml
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.~

# --- Env / Logs ---
.env
.env.local
*.log
logs/

# --- Maven wrapper ---
!.mvn/wrapper/maven-wrapper.jar

# --- Spring Boot 运行态临时文件 ---
.spring-boot-pid

# --- 临时验证输出（v2.6 2026-07-09 补充）---
# SSE 验证脚本的临时输出文件
sse*.txt
# verify-mcp-e2e.ps1 生成的临时终态查询脚本
m5-e2e-psql.log.sql
# 临时编译日志（建议用 IDE / mvn 直接看，不入仓）
.mvn-compile-*.log

# --- e2e 脚本 SQL 输出文件（v2.6.2 2026-07-17 补充）---
# verify-*.ps1 写出的 psql 输出结果，重跑即覆盖
*.out
*.out.pre
*.out.bak
# --- 临时调试与诊断产物（v2.6.2 2026-07-17 补充）---
tmp/
.tmp/
.dbg/
# --- Runtime data (ArtifactStorage 本地落盘产出物) ---
data/

# --- Phase B 临时验证产物（一次性脚本与运行结果目录，不入仓）---
phase-b-*.ps1
phase-b-rs-*/
helmet-poster-*.png
helmet-research-*.png
