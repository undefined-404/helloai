# ============================================================
# HelloAI .gitignore
# ============================================================

# --- Java / Maven ---
*.class
*.jar
*.war
*.ear
target/
# JVM/JIT profiling 临时产物（mvn test 生成，不入仓）
*.profraw
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
dependency-reduced-pom.xml
build/

# --- Vue / Node ---
node_modules/
dist/
*.tsbuildinfo

# --- IDE ---
.idea/
*.iml
*.iws
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.~

# --- Env / Logs ---
.env
.env.local
*.log
logs/

# --- Maven wrapper ---
!.mvn/wrapper/maven-wrapper.jar

# --- Spring Boot 运行态临时文件 ---
.spring-boot-pid

# --- Python（工具脚本的字节码缓存，不入仓）---
# tools/ 下的一次性 Python 工具运行后会生成 __pycache__/*.pyc（2026-09-29 补充）
__pycache__/
*.pyc

# --- 临时验证输出（v2.6 2026-07-09 补充）---
# SSE 验证脚本的临时输出文件
sse*.txt
# verify-mcp-e2e.ps1 生成的临时终态查询脚本
m5-e2e-psql.log.sql
# 临时编译日志（建议用 IDE / mvn 直接看，不入仓）
.mvn-compile-*.log

# --- e2e 脚本 SQL 输出文件（v2.6.2 2026-07-17 补充）---
# verify-*.ps1 写出的 psql 输出结果，重跑即覆盖
*.out
*.out.pre
*.out.bak
# --- 临时调试与诊断产物（v2.6.2 2026-07-17 补充）---
tmp/
.tmp/
.dbg/
# --- 本地工具链（REF-2 起：宿主侧 pg_dump/pg_restore，免安装 zip 版解压于此） ---
# 与 JDK / Maven 同类：仅「本地源码开发」需要，服务器 Docker 一键部署由镜像内的
# postgresql-client 提供（见 Dockerfile 的 app 阶段），不依赖本目录。
.tools/
# --- Qoder IDE 缓存（plans / skills 缓存目录，不入仓） ---
.qoder/
.trae/
# --- 其他 AI 编程工具本地目录（skills / hooks / plans / repowiki 均为本地产物，不入仓 2026-09-30）---
# 说明：.qoder/ 于 2026-09-30 之前已列入本文件但未执行 git rm --cached，
#       导致 clone 仍然携带；本次四类目录统一 untrack（文件保留在本地工作区）。
.agents/
.claude/
.cursor/
# --- impeccable 工具缓存（critique 快照等本地产物，不入仓） ---
.impeccable/
# --- Executor 值班脚本运行时配置（含真实 apiKey / agentId，勿入库） ---
**/skills/**/config.json
# executor-onboard.ps1 生成的运行时配置（真实 apiKey，勿入库）
scripts/powershell/executor-config.json
# executor-onboard.ps1 生成的上手文档与平台导出 SKILL（含真实 apiKey，勿入库）
.executor-onboarding.md
scripts/powershell/executor-SKILL.md
# --- Runtime data (ArtifactStorage 本地落盘产出物) ---
data/

# --- Phase B 临时验证产物（一次性脚本与运行结果目录，不入仓）---
phase-b-*.ps1
phase-b-rs-*/
helmet-poster-*.png
helmet-research-*.png

# --- WorkBuddy 本地工作区（含 memory / 本地缓存，不入仓 2026-09-29）---
.workbuddy/

# --- 本地一次性工具脚本（本地测试/调试工具，不入仓 2026-09-29）---
# tools/ 下为本地运行的一次性 Python 工具（如 ai-video-search），非项目交付物
tools/

# --- Executor 配置文件（含真实 apiKey，一律不入仓 2026-09-29 安全修复）---
# 原名 executor-config.public.json 具有误导性，实际含真实 Agent Key，扩展为通配
scripts/powershell/executor-config*.json

# --- 本地 AI 技能安装器锁文件与安装目录（仅仓库根，勿用裸 skills/ —— 会误伤
#     helloai-core/src/main/resources/skills/ 下的运行时能力包 2026-09-30）---
/skills-lock.json
/skills/

# --- scripts 运行日志与 jar 解包残留（本地产物，不入仓 2026-09-30）---
scripts/powershell/logs/
