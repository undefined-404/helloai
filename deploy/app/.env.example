# ============================================================
# HelloAI 服务器部署 .env 模板
# 用法：cp .env.example .env 后填入真实值（.env 已 gitignore）
# 消费方：deploy/app/docker-compose.yml
#         （拷到服务器后即为 /home/admin/helloai/docker-compose.yml）
# ============================================================
#
# 以下 8 个键在 compose 里全部是 `:?` 必需项 —— 缺失时 `docker compose up`
# 在**解析阶段**就报错退出（连容器都不会创建），会明确说出缺哪个变量。
# 推荐直接跑 `bash deploy/init-env.sh` 自动生成，不用手写本文件。
#
# 2026-11-26 追加 REDIS_PASSWORD：Redis 曾以无密码 + `0.0.0.0:26379` 暴露在公网
#   （与 PG 默认口令、MinIO 默认凭据同一形态），实测被外部写入。现在 requirepass
#   为强制项，缺失即 fail-fast，因此本键**必须**在 .env 里。
#
# 2026-10-19 重写：原模板引用 MIDDLEWARE_HOST / POSTGRES_PASSWORD /
#   HELLOAI_REDIS_PASSWORD / HELLOAI_S3_SECRET_KEY，这 4 个键 compose 从不读取
#   （PG 口令、Redis 无密码、MinIO 凭据都写在 compose 里），而真正必需的
#   AGENT token 与 SANDBOX key 反而缺失。按 compose 实际引用重写。

# --- RabbitMQ 管理员（rabbitmq-init 用它创建 vhost 与业务用户）---
# 必须是非 guest 的专用管理员：guest 官方限制仅允许回环登录，兄弟容器用不了。
# 已有 data volume 的 broker 改 RABBITMQ_DEFAULT_USER/PASS 无效，需一次性手工建：
#   docker exec helloai-rabbitmq rabbitmqctl add_user <管理员> <密码>
#   docker exec helloai-rabbitmq rabbitmqctl set_user_tags <管理员> administrator
RABBITMQ_ADMIN_USER=helloaiadmin
RABBITMQ_ADMIN_PASSWORD=change-me

# --- Redis 口令（requirepass，2026-11-26 起强制）---
# compose 里是 `:?`，缺失直接解析失败。以下三处共用同一个值，切勿分叉：
#   redis 的 --requirepass / app 的 SPRING_DATA_REDIS_PASSWORD / healthcheck。
# 生成：openssl rand -hex 16
# 注意：值里不要带 `$` 与空白（compose 解析 command 数组时会被当分隔）。
REDIS_PASSWORD=change-me

# --- RabbitMQ 业务用户 ---
# app 与 rabbitmq-init 共用这一个变量（同一事实只允许一个来源，切勿分叉）。
# vhost 固定 /helloai（带前导斜杠），不是 helloai —— 二者在 RabbitMQ 里是两个实体。
HELLOAI_RABBIT_USER=helloai
HELLOAI_RABBIT_PASSWORD=change-me

# --- 凭据加密密钥（credential_vault 的 AES-256-GCM key，32 字节 base64）---
# 必须与数据库中已有密文配对的原始 key。换掉 = 全部 provider API Key 解不开
# （Tag mismatch），需要把每个 Key 重新录一遍。
# 全新部署、库中还没有 credential 行时才可以随机生成：openssl rand -base64 32
HELLOAI_CREDENTIAL_AES_KEY_BASE64=change-me

# --- Agent 自注册共享令牌 ---
# 只校验「注册新 agent」的请求（POST /api/agents/registerWithToken），
# 不影响已注册 agent 的正常鉴权（它们走 apiKey / Bearer）。
# 生成：openssl rand -hex 32
HELLOAI_AGENT_REGISTRATION_TOKEN=change-me

# --- OpenSandbox 服务端 API Key ---
# 该容器挂载 /var/run/docker.sock，拿到这个 key + 能访问 8090 就等于宿主机 root，
# 必须是强随机值：openssl rand -hex 32
# opensandbox-server 是常驻服务（2026-10-26 起已无 sandbox profile，普通
# `docker compose up -d` 就会启动），compose 解析阶段即校验本变量，缺失会让
# 任何 `docker compose up`（包括只起中间件）报错退出 —— 所以这里必须填。
OPEN_SANDBOX_API_KEY=change-me

# --- 数据库口令（可选覆盖，默认沿用历史值 postgres）---
# compose 用 `${DATASOURCE_PASSWORD:-postgres}`，不填即沿用旧值（零行为变化）。
# 轮换时：改本行 + 同一维护窗口内 `ALTER USER postgres PASSWORD '<新值>'`，
# 两步必须一起做，只改一侧会让 app 连不上库。
DATASOURCE_PASSWORD=postgres

# --- Sandbox workspace volume (SL-10, optional) ---
# true 时 /workspace 从容器可写层改为宿主目录卷：executor 挂 rw、reviewer 挂 ro。
# 必须同时让 sandbox server 的 [storage].allowed_host_paths 放行同一路径
# （config.toml 里引用同一个 SANDBOX_VOLUME_HOST_PATH 变量）。
# 两侧改动都要 `docker compose up -d --force-recreate`，restart 不会重读。
# 注意：单一 host-path 是整个部署共享目录，所有任务互相可见。
SANDBOX_VOLUME_ENABLED=false
SANDBOX_VOLUME_HOST_PATH=/home/admin/helloai/sandbox-workspace
