# ============================================================
# HelloAI app deployment .env example
# Usage: cp .env.example .env, fill real values (.env is gitignored)
# This file is consumed by docker-compose.server.yml (app + web).
# Put it in the same deploy dir as docker-compose.server.yml.
# Password rules: alphanumeric; must match deploy/middleware/.env.
# ============================================================

# Middleware server host (public or internal reachable IP / hostname)
MIDDLEWARE_HOST=change-me.example.com

# PostgreSQL (HelloAI) - matches middleware .env POSTGRES_PASSWORD
POSTGRES_PASSWORD=change-me

# Redis (ACL user helloai) - matches middleware .env HELLOAI_REDIS_PASSWORD
HELLOAI_REDIS_PASSWORD=change-me

# RabbitMQ (user helloai, vhost /helloai) - password matches HELLOAI_RABBIT_PASSWORD
# ⚠️ vhost 是 /helloai（带前导斜杠），不是 helloai —— 二者在 RabbitMQ 里是两个不同实体。
# ⚠️ 该密码由 app 与 rabbitmq-init【共用同一个变量】，改一处即两侧同时生效，
#    切勿给 app 与 init 分别设不同值（分叉会直接导致认证失败）。
HELLOAI_RABBIT_PASSWORD=change-me

# RabbitMQ admin (consumed by rabbitmq-init service)
# ⚠️ 必须是非 guest 的【专用管理员】：RabbitMQ 官方限制 guest 仅允许回环登录
#    （与协议无关，AMQP 与 Management HTTP API 都受限）；rabbitmq-init 是兄弟容器，用 guest 必然被拒。
# ⚠️ RABBITMQ_DEFAULT_USER/PASS 只在节点【首次启动】创建；已有 volume 的 broker 改它无效，
#    须一次性手工执行：rabbitmqctl add_user <管理员> <密码> + set_user_tags <管理员> administrator
RABBITMQ_ADMIN_USER=change-me
RABBITMQ_ADMIN_PASSWORD=change-me

# MinIO (user helloai-s3, bucket helloai-artifacts) - matches HELLOAI_S3_SECRET_KEY
HELLOAI_S3_SECRET_KEY=change-me
# MinIO access/secret keys consumed by the app (S3 user helloai-s3).
# Required since 2026-09-30: application.yml no longer ships credential defaults
# (CODE_STYLE sec 41/42, fail-fast when missing).
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me

# Credential AES key (must equal the original key from the release build)
HELLOAI_CREDENTIAL_AES_KEY_BASE64=change-me

# Agent self-registration shared token (helloai.agent.registration-token).
# Required since 2026-09-30: the former hard-coded value "helloai-reg-2024" was
# rotated/retired; the app now fails fast when this is missing (CODE_STYLE sec 41/42).
HELLOAI_AGENT_REGISTRATION_TOKEN=change-me