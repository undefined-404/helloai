# ============================================================
# Middleware standalone deployment .env template
# Usage: cp .env.example .env then update all passwords
#        (.env is excluded by .gitignore)
# Password rules: alphanumeric only. Redis ACL passwords must
#        contain no spaces; quotes break JSON/ACL syntax.
# Save this file as ASCII/UTF-8 without BOM.
# ============================================================

# Common
TZ=Asia/Shanghai

# ===== PostgreSQL (HelloAI) =====
POSTGRES_PASSWORD=Postgres_ChangeMe_2026

# ===== MySQL (other project) =====
MYSQL_ROOT_PASSWORD=MySql_ChangeMe_2026
# DB name used by the other project (auto-created by mysql-other before migration)
MYSQL_DATABASE=other_project

# ===== Redis (ACL user isolation) =====
# default user: admin fallback password
REDIS_DEFAULT_PASSWORD=Redis_ChangeMe_2026
# helloai user: dedicated to the HelloAI application
HELLOAI_REDIS_PASSWORD=RedisHelloai_ChangeMe_2026

# ===== RabbitMQ (vhost isolation) =====
# admin (management UI / rabbitmq-init)
# ⚠️ 必须是非 guest 的【专用管理员】：RabbitMQ 官方限制 guest 仅允许回环登录
#    （与协议无关，AMQP 与 Management HTTP API 都受限）。
#    rabbitmq-init 是兄弟容器（非回环），用 guest 必然 403 / ACCESS_REFUSED。
# ⚠️ 另注意：RABBITMQ_DEFAULT_USER/PASS 只在节点【首次启动】时创建。
#    已有 volume 数据的 broker 改这两个变量【完全无效】，
#    需一次性手工执行 rabbitmqctl add_user <管理员> <密码> + set_user_tags <管理员> administrator。
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=RabbitAdmin_ChangeMe_2026
# HelloAI business user (only /helloai vhost)
HELLOAI_RABBIT_USER=helloai
HELLOAI_RABBIT_PASSWORD=RabbitHelloai_ChangeMe_2026
# 业务 vhost 固定为 /helloai，【不可配置】：
#   init.sh 硬编码创建此 vhost（走 Management API 时须 URL 编码为 %2Fhelloai）。
#   曾以 HELLOAI_RABBIT_VHOST 暴露为可配置项，但 init.sh 从未读取它 ——
#   改它只会让 app 与 init.sh 分叉、造成静默连不上（「空旋钮」），故已移除。

# ===== MinIO (bucket + access key isolation) =====
# root (Console / operations)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=Minio_ChangeMe_2026
# HelloAI project S3 user (only helloai-artifacts bucket, created by minio-init)
HELLOAI_S3_ACCESS_KEY=helloai-s3
HELLOAI_S3_SECRET_KEY=HelloaiS3_ChangeMe_2026