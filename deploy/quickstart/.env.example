# ============================================================================
# HelloAI Quickstart - environment template
#
# start.sh / start.ps1 COPY this file to .env and fill every blank on the
# first run. Never commit the resulting .env: it holds real secrets.
#
# Only the SECRETS need values; everything else is topology and already
# lives inside the app image (application-quickstart.yml).
# ============================================================================

# --- Images (prebuilt; no JDK / Maven / Node / source tree required) ---
# App and web must carry the SAME version, so the two lines below are always
#   written as a pair.
#   Release bundle : build-release.sh rewrites both to the bundled version.
#                    Do not edit them afterwards.
#   Local build    : leave them at :local and build the images yourself
#                    (from the repo root, JDK 17 + Node needed once):
#     docker build -f Dockerfile --target app -t helloai-app:local .
#     docker build -f Dockerfile --target web -t helloai-web:local .
# Prebuilt images from the project public ACR (anonymous pull, no login).
#   Point these at your own registry if you fork and rebuild.
HELLOAI_APP_IMAGE=crpi-y0c6x9ls3zo4d4je.cn-beijing.personal.cr.aliyuncs.com/helloai/app:0.2.0
HELLOAI_WEB_IMAGE=crpi-y0c6x9ls3zo4d4je.cn-beijing.personal.cr.aliyuncs.com/helloai/web:0.2.0

# --- Entry port (change if 8080 is taken) ---
HELLOAI_HTTP_PORT=8080

# --- JVM heap ---
# 2g covers normal use. Raise it if you upload large attachments or run
# long final-report consolidation on a big machine.
HELLOAI_JVM_XMX=2g

# --- Secrets (leave blank: generated on first run) ---
# Postgres superuser password
DATASOURCE_PASSWORD=

# RabbitMQ business account. The vhost is pinned to /helloai.
HELLOAI_RABBIT_USER=helloai
HELLOAI_RABBIT_PASSWORD=

# Credential vault encryption key (AES-256, base64).
# CRITICAL: this key decrypts every stored LLM API key. Once generated it
# must be kept forever. Replacing it (or deleting .env) makes all existing
# credentials permanently undecryptable.
HELLOAI_CREDENTIAL_AES_KEY_BASE64=

# Shared secret for external Agent self-registration.
HELLOAI_AGENT_REGISTRATION_TOKEN=

# MinIO root account (used by the app as its S3 credentials).
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# OpenSandbox server API key (only used with --with-sandbox).
SANDBOX_API_KEY=

# Host port for the sandbox server (loopback only). Change it when 8090 is
#   already taken on this machine.
#   NOTE: this only buys co-existence with a stack that does NOT run a sandbox
#   server -- two sandbox servers on the same docker.sock still fight over the
#   40000-60000 sandbox port range. Run one at a time.
HELLOAI_SANDBOX_PORT=8090
