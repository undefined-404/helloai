  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "确认草案后全自动：分发 → 认领 → 执行 → 提交 → 核验 → 整合报告",
        "人工只剩两处：确认草案 + 死信池四出口（指派 / 验收 / 改派 / 放弃）"
      ]
    },
    {
      "dot": "amber",
      "title": "状态迁移",
      "items": [
        "PENDING_PLAN_REVIEW → PENDING → ASSIGNED → IN_PROGRESS → REVIEW → DONE",
        "驳回走 REVIEW → REWORK → IN_PROGRESS；租约到期是 IN_PROGRESS → PENDING 唯一合法入口"
      ]
    },
    {
      "dot": "rose",
      "title": "异常路径",
      "items": [
        "阻塞：reportBlocked 上报 → 人工放行 → 重新派发",
        "熔断：返工达上限 / 重分配达上限 → DEAD_LETTER，自动链路停止转人工兜底"
      ]
    }
  ]
