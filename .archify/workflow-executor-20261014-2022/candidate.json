  "cards": [
    {
      "dot": "cyan",
      "title": "双执行链",
      "items": [
        "外部 MCP Agent：13 工具（pullTasks/ack/claimSubTask/startSubTask/heartbeat/uploadArtifact/submitResult/reportBlocked/getAgentStatus/getDepsSummary/getSubTaskDetail/checkIn/checkOut）",
        "平台内 RuntimeTurnExecutor：AgentLoop 迭代 + 沙箱策略 + 工具注册表，与外部链同口径回写审核"
      ]
    },
    {
      "dot": "emerald",
      "title": "三层幂等",
      "items": [
        "claimAtomic：SQL CAS（status=PENDING 且 assigned 为空或本人）+ version 乐观锁，并发认领只成功一次",
        "submitResult：resultId 幂等键，同一子任务重复提交不重复入审；finishReason 记录 completed/failed/timeout"
      ]
    },
    {
      "dot": "rose",
      "title": "租约与熔断",
      "items": [
        "IN_PROGRESS 写 owner + lease_until（TTL 300s）；Watchdog 150s 续期（无 ShedLock，每节点独立）",
        "Reconciler 30s 扫描回收（ShedLock 单例，batch 200）；熔断 30%/60s/10 窗，降级选同角色替代，无替代抛 409"
      ]
    }
  ]
