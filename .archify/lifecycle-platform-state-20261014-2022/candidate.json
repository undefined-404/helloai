  "cards": [
    {
      "dot": "cyan",
      "title": "子任务状态机（本图主体）",
      "items": [
        "11 态全量迁移由 SubTaskStateMachine 迁移表单点校验，非法迁移直接抛错",
        "草案态 PENDING_PLAN_REVIEW 对 claim / assignNext / 自动重派 / 补偿任务全部不可见"
      ]
    },
    {
      "dot": "emerald",
      "title": "主任务五态（TaskStatus）",
      "items": [
        "PENDING → PLANNING → IN_PROGRESS → DONE / CANCELLED",
        "拆解触发 CAS 进 PLANNING；confirmPlan 确认草案后进 IN_PROGRESS；子任务全部终态后幂等收敛 DONE"
      ]
    },
    {
      "dot": "amber",
      "title": "最终报告五态（FinalReportStatus）",
      "items": [
        "NONE → GENERATING → REVIEWING → DONE，失败降 FAILED",
        "TaskAutoCompletedEvent 是 NONE → GENERATING 唯一入口；审查链 L1 事件 / L2 死信重放 / L3 孤儿巡检三级容错，回滚经 DONE → GENERATING"
      ]
    }
  ]
