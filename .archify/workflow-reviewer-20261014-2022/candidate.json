  "cards": [
    {
      "dot": "cyan",
      "title": "三级容错触发",
      "items": [
        "L1 AFTER_COMMIT + @Async 事件主路径；L2 MQ reviewerQueue（Outbox 补偿，Redis + DB 双层幂等）；L3 30s 孤儿扫描（60s 阈值，batch 10）",
        "Redisson RLock 120s 互斥 + 状态必须仍为 REVIEW 双重防重：三路并发只一路进入，其余直接跳过"
      ]
    },
    {
      "dot": "emerald",
      "title": "双审与判定",
      "items": [
        "difficulty=HIGH 且候选 ≥ 2（两位模型不同）走双审并行，90s 共同 deadline；REQUIRE_BOTH 一致才落地，分歧停留 REVIEW 转人工",
        "通过 → DONE（触发隐式评分与下游解锁）；驳回 → REWORK，核验意见入 reviewHistory，对 API_KEY_LLM 执行者重下发执行命令闭合返工"
      ]
    },
    {
      "dot": "rose",
      "title": "熔断与反馈",
      "items": [
        "返工达上限（默认 3 次）或共享预算耗尽 → DEAD_LETTER；人工四出口：指派 / 放弃 / 直接验收 / 驳回改派",
        "抽检复审：1h 周期、5% 抽样、单轮上限 20，只度量不改状态（放水率进 review_recheck_log）；最终报告 3A 闭环：保真机械门 → LLM 审查 → 返工重写，自审同 Agent 过硬守卫"
      ]
    }
  ]
