{
  // ============================================================
  // Cloudflare Workers 静态站点部署配置
  // ------------------------------------------------------------
  // 用途：把 docs-site/ 作为纯静态站点发布到 Cloudflare Workers。
  //
  // ★ 为什么用 Workers 而非 legacy Pages 流程：
  //   Cloudflare 控制台的 Deploy command 是 `npx wrangler deploy`
  //   （Workers Builds 流程）。若同时配置 pages_build_output_dir，
  //   wrangler 会把项目判定为 Pages 项目并告警：
  //     "It seems that you have run wrangler deploy on a Pages project"
  //   故此处**只保留 assets.directory**，与 Workers 流程严格对应。
  //   （实测：去掉该字段后告警消失，仍正确读取 24 个文件）
  //
  // ★ name 必须与 Cloudflare 控制台的项目名完全一致，否则部署失败。
  //   当前项目名：helloai
  //
  // ★ 站点内容：docs-site/（index.html + 6 张交互图 + 9 张 SVG + 4 张 PNG）
  //   修改资源后先跑 `bash scripts/sync-docs-site.sh` 同步，再提交推送，
  //   Cloudflare 会自动重新部署。
  // ============================================================
  "$schema": "node_modules/wrangler/config-schema.json",

  // 项目名（必须与 Cloudflare 控制台一致）
  "name": "helloai",

  // 兼容日期：Cloudflare 要求的运行时行为基准
  "compatibility_date": "2026-10-15",

  // 静态资源目录：站点内容所在位置
  "assets": {
    "directory": "./docs-site"
  }
}
