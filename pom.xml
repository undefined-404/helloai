<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.helloai</groupId>
    <artifactId>helloai</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>HelloAI</name>
    <description>AI Agent 协作调度平台 — Hello World!</description>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <spring-boot.version>3.4.10</spring-boot.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <!-- 3.5.9+ 起 PaginationInnerInterceptor 拆分到 mybatis-plus-jsqlparser 独立模块，
             3.5.12 聚合 POM 已包含该模块（本地 m2 已缓存），否则分页插件类缺失（G-012 实测暴露） -->
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <mybatis-spring.version>3.0.4</mybatis-spring.version>
        <postgresql.version>42.7.3</postgresql.version>
        <springdoc.version>2.8.0</springdoc.version>
        <flyway.version>10.14.0</flyway.version>
        <guava.version>33.2.0-jre</guava.version>
        <lombok.version>1.18.32</lombok.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <minio.version>8.5.12</minio.version>
        <!-- Redisson 分布式锁（子任务审核并发锁迁移，v1.2 §阶段1） -->
        <redisson.version>4.0.0</redisson.version>
        <!-- ShedLock 定时任务分布式锁（11 个 job 任务迁移，v1.2 §阶段2） -->
        <shedlock.version>6.6.0</shedlock.version>
        <!-- Sa-Token 鉴权底座（RBAC：登录会话 + @SaCheckPermission 权限码） -->
        <sa-token.version>1.44.0</sa-token.version>

        <!-- 打包时默认跳过测试执行，需要跑测试时加 -DskipTests=false -->
        <skipTests>true</skipTests>
    </properties>

    <modules>
        <module>helloai-common</module>
        <module>helloai-mq</module>
        <module>helloai-job</module>
        <module>helloai-core</module>
        <module>helloai-api</module>
        <module>helloai-start</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Testcontainers BOM 2.0.5（2026-09-29 必选：须声明在 spring-boot-dependencies 之前才能覆盖其 1.20.6）：
                 新版 Docker Desktop（4.38+ 管道中继）对 npipe 请求强制要求 HTTP Host 头，
                 内嵌 docker-java 3.x 的 1.20.6 被 400 拒绝（本机 Docker Engine 29.2.1 实测），
                 升级 2.0.x（非 shaded、docker-java 4.x）修复；Linux/CI 不受影响但统一版本 -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>2.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- 2.0.5 前置 import 仍不足以覆盖 spring-boot-dependencies 对核心三件的直接版本管理，
                 须补显式条目（直接声明 > BOM import）：保证四件套版本统一 2.0.5。
                 注意 2.x 模块改名：junit-jupiter→testcontainers-junit-jupiter、
                 postgresql→testcontainers-postgresql、rabbitmq→testcontainers-rabbitmq，
                 1.x 旧名只有 1.21.x，无 2.0.5（阿里云实测与 Central 目录验证一致） -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>2.0.5</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-junit-jupiter</artifactId>
                <version>2.0.5</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-postgresql</artifactId>
                <version>2.0.5</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-rabbitmq</artifactId>
                <version>2.0.5</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            
            <!-- Spring AI BOM（v2.4 §3.1 MCP Server 标准化，路线 C） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>com.helloai</groupId>
                <artifactId>helloai-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.helloai</groupId>
                <artifactId>helloai-mq</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.helloai</groupId>
                <artifactId>helloai-job</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.helloai</groupId>
                <artifactId>helloai-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.helloai</groupId>
                <artifactId>helloai-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>${mybatis-spring.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-database-postgresql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <!-- Resilience4j 熔断降级（v2.4 §4.4） -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-spring-boot3</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <!-- MinIO 对象存储 SDK（附件存储后端，v2.7 引入；okhttp 传递依赖） -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!-- Redisson 分布式锁（v1.2 §阶段1：SubTaskReview 锁迁 RLock；4.0.0 starter 默认带 spring-data-40 适配器，
                 Boot 3.4 需显式用 redisson-spring-data-34 并排除 40） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- redisson-spring-boot-starter:4.0.0 上游依赖错配（传递 redisson:3.45.0，缺 Config.setUsername 导致
                 RedissonAutoConfiguration 启动失败）；强制 core 对齐 4.0.0，与 starter / spring-data-34 同版本族 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- Redisson × Spring Data Redis 3.4 适配（Boot 3.4.10 → spring-data-redis 3.4.x） -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-data-34</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- ShedLock 定时任务锁（v1.2 §阶段2：11 个 @Scheduled 任务迁 @SchedulerLock） -->
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-redis-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <!-- Sa-Token BOM（统一管理 sa-token-* 版本） -->
            <dependency>
                <groupId>cn.dev33</groupId>
                <artifactId>sa-token-dependencies</artifactId>
                <version>${sa-token.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <!-- 必须显式钉版本（2026-10-08 CI 修复）：不写 version 时 Maven 会解析「当前最新 RELEASE」，
                     而本机走阿里云镜像（~/.m2/settings.xml, mirrorOf=*）元数据滞后、CI 直连 central，
                     结果同一份代码在本机与 CI 跑的是两套插件（实测 3.13.0 vs 3.16.0）——
                     门禁「本地可复现」形同虚设，且产生 'plugin.version is missing' 警告。 -->
                <version>3.16.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <!-- 钉版本：理由同 maven-compiler-plugin（不钉会导致 3.2.5 与 3.6.0 漂移，
                         连 surefire 报告的文件数都不同：343 vs 198）。 -->
                    <version>3.6.0</version>
                    <configuration>
                        <systemPropertyVariables>
                            <!-- 测试 JVM 固定业务时区，不随宿主机/CI runner 漂移
                                 （2026-10-08 CI 失败根因：runner 是 UTC，用例期望值是 +08:00）。
                                 生产口径同源：容器与 compose 均设 TZ=Asia/Shanghai。
                                 注意：只影响 fork 出来的测试 JVM，不改变应用运行时行为。 -->
                            <user.timezone>Asia/Shanghai</user.timezone>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                    <executions>
                        <execution>
                            <id>repackage</id>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
