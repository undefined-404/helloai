<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.helloai</groupId>
        <artifactId>helloai</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>helloai-start</artifactId>
    <name>HelloAI Start</name>
    <description>启动入口：HelloAIApplication、application.yml、Flyway 脚本</description>

    <dependencies>
        <dependency>
            <groupId>com.helloai</groupId>
            <artifactId>helloai-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.helloai</groupId>
            <artifactId>helloai-job</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <!-- 分页插件依赖（mybatis-plus 3.5.9+ 把 PaginationInnerInterceptor 拆到 jsqlparser
             独立模块且为 optional，需显式引入，否则分页 COUNT/LIMIT 不生效，见 G-012） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser-4.9</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标抓取端点（监控栈阶段1：/actuator/prometheus） -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-deepseek</artifactId>
        </dependency>
        <!-- 测试（B 级集成测试基础设施，2026-09-29：Testcontainers PG/Redis/RabbitMQ）
             版本默认由 spring-boot-dependencies 3.4.10 管理；根 pom dependencyManagement
             自 2026-09-29 起前置导入 testcontainers-bom 2.0.5 覆盖（兼容新版 Docker Desktop npipe 中继）；
             2.x 模块改名：junit-jupiter→testcontainers-junit-jupiter 等（见根 pom 注释） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
