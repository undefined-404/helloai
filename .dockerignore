# ============================================================================
# HelloAI - .dockerignore (build context trim)
# Keeps the Docker build context small and avoids copying generated artifacts
# (target/, dist/, node_modules/, .git/) into `docker compose build`.
# ============================================================================

# Git
.git
.gitignore
.gitattributes

# Java build output
target/
**/target/
*.jar
!pom.xml
!**/pom.xml

# Node
node_modules/
**/node_modules/
helloai-ui/dist/

# Local / tooling
.workbuddy/
tools/
.tmp/
logs/
.cache/
.vscode/
.idea/
*.iml

# Runtime config (never bake secrets into an image)
.env
.env.local
executor-config*.json
application-local.yml
# application-dev.yml in the working tree is skip-worktree and carries REAL
# credentials (cloud IP, RabbitMQ/MinIO passwords, AES key). Excluding it means
# a revived image build fails fast on a missing dev profile instead of shipping
# those secrets. See the SECURITY NOTE in Dockerfile.
**/application-dev.yml

# Docs / misc (not needed for the image)
doc/
scripts/
*.md

# Deploy artifacts (not needed in the image)
deploy/*

# Release bundles (deploy/quickstart/build-release.sh writes here, and a second
# run would otherwise push the previous version's multi-GB offline tars into the
# build context). Leading slash = context root only, so helloai-ui/dist stays
# excluded above on its own rule.
/dist/
/dist
